{
  "expo": {
    "name": "wanderwild",
    "slug": "wanderwild",
    "entryPoint": "./client/app/index.tsx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./client/assets/assets/images/icon.png",
    "scheme": "wanderwild",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fcrstudio.wanderwild",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
  "foregroundImage": "./client/assets/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.fcrstudio.wanderwild"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
  "favicon": "./client/assets/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./client/assets/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "daaa2459-e16e-4eb9-a29e-4eaeebc6158d"
      }
    }
  }
}
